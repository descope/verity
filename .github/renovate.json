{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "enabledManagers": ["gomod", "github-actions", "npm", "mise", "docker-compose", "helmv3"],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker image digest pins in workflow env/run blocks",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n.*?:\\s*\\S+?:(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n[^\\n]+\\s\\S+?:(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Go dependencies",
      "matchManagers": ["gomod"],
      "labels": ["go", "dependencies"],
      "groupName": "go dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "labels": ["github-actions", "dependencies"],
      "groupName": "github actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "mise tools",
      "matchManagers": ["mise"],
      "labels": ["tools", "dependencies"],
      "groupName": "mise tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "npm (site)",
      "matchManagers": ["npm"],
      "labels": ["npm", "dependencies"],
      "groupName": "npm dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Automerge non-major updates",
      "matchManagers": ["gomod", "github-actions", "mise", "npm", "helmv3"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Infrastructure images (BuildKit, registry)",
      "matchManagers": ["custom.regex", "docker-compose"],
      "labels": ["infrastructure", "dependencies"],
      "groupName": "infrastructure images",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "Helm chart dependencies",
      "matchManagers": ["helmv3"],
      "labels": ["helm", "dependencies"],
      "groupName": "helm charts",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true,
    "schedule": ["at any time"]
  },
  "timezone": "UTC",
  "schedule": ["before 4am on Monday"],
  "prConcurrentLimit": 3,
  "prCreation": "immediate"
}
