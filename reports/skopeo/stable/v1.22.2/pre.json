        {
          "author": "Fedora Project Contributors \u003cdevel@lists.fedoraproject.org\u003e",
          "created": "2026-05-31T15:23:11.117809135Z",
          "created_by": "|4 FLAVOR=stable INSTALL_RPMS=skopeo fuse-overlayfs  /bin/sh -c dnf -y update \u0026\u0026     rpm --setcaps shadow-utils 2\u003e/dev/null \u0026\u0026     case \"${FLAVOR}\" in       stable)         dnf -y install $INSTALL_RPMS --exclude container-selinux       ;;       testing)         dnf -y install $INSTALL_RPMS --exclude container-selinux             --enablerepo updates-testing       ;;       upstream)         dnf -y install 'dnf-command(copr)' --enablerepo=updates-testing \u0026\u0026         dnf -y copr enable rhcontainerbot/podman-next \u0026\u0026         dnf -y install $INSTALL_RPMS             --exclude container-selinux             --enablerepo=updates-testing       ;;       *)         printf \"\\\\nFLAVOR argument must be set and valid, currently: '${FLAVOR}'\\\\n\\\\n\" 1\u003e\u00262 \u0026\u0026         exit 1       ;;     esac \u0026\u0026     dnf clean all \u0026\u0026     if test -n \"$SOURCE_DATE_EPOCH\" ; then         sqlite3 /usr/lib/sysimage/libdnf5/transaction_history.sqlite \"UPDATE trans SET dt_begin=$SOURCE_DATE_EPOCH, dt_end=$SOURCE_DATE_EPOCH; PRAGMA journal_mode=DELETE; PRAGMA journal_mode=WAL\" ;     fi \u0026\u0026     rm -fv /etc/machine-id /var/lib/systemd/random-seed /var/lib/dnf/repos/*/countme \u0026\u0026     rm -fv /usr/lib/systemd/profile.d/* \u0026\u0026     rm -rf /var/cache /var/log/dnf* /var/log/yum.*"
        },
        {
          "author": "Fedora Project Contributors \u003cdevel@lists.fedoraproject.org\u003e",
          "created": "2026-05-31T15:23:13.001670358Z",
          "created_by": "|4 FLAVOR=stable INSTALL_RPMS=skopeo fuse-overlayfs  /bin/sh -c useradd skopeo \u0026\u0026     echo -e \"root:1:65535\\nskopeo:1:999\\nskopeo:1001:64535\" \u003e /etc/subuid \u0026\u0026     echo -e \"root:1:65535\\nskopeo:1:999\\nskopeo:1001:64535\" \u003e /etc/subgid"
        },
