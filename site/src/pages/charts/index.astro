---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CopyButton from "../../components/CopyButton.astro";
import SeverityBadges from "../../components/SeverityBadges.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { fullCatalog } from "../../data/full-catalog";
import { getChartsCatalog } from "../../lib/charts";
import type { ChartEntry, ChartImageMapping } from "../../lib/charts";
import { getImageVulns, getChartVulns } from "../../lib/chart-vulns";
import { patchedRefToName } from "../../lib/refs";

const base = import.meta.env.BASE_URL;
const chartsCatalog = getChartsCatalog();
const charts = chartsCatalog.charts;
const totalOverrides = charts.reduce(
  (sum, c) => sum + c.imageMappings.length + c.valueOverrides.length,
  0
);

// Precompute chart vuln summaries to avoid duplicate getChartVulns calls
const chartVulnMap = new Map(charts.map((c) => [c.name, getChartVulns(c)]));
const totalCVEs = charts.reduce((sum, c) => sum + (chartVulnMap.get(c.name)?.total ?? 0), 0);

// Build image-name → source lookup from full catalog for accurate SourceBadge
const imageSourceMap = new Map<string, string>();
for (const cat of fullCatalog) {
  for (const img of cat.images) {
    imageSourceMap.set(img.name, img.source);
  }
}
---

<BaseLayout title="Helm Charts — Verity" mdUrl={`${base}charts/index.md`}>
  <nav class="text-sm text-verity-text-secondary mb-6">
    <a href={base} class="hover:text-verity-nucleus transition-colors">Home</a>
    <span class="mx-1">/</span>
    <span class="text-verity-text-primary">Charts</span>
  </nav>

  <div class="mb-10">
    <h1 class="text-3xl font-bold mb-2 text-verity-text-primary">Helm Charts</h1>
    <p class="text-verity-text-muted text-lg">
      Pre-patched wrapper Helm charts that override upstream image references with Verity's
      security-patched equivalents. Install a chart and every container image is already patched.
    </p>
  </div>

  <!-- Summary cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
    <div class="bg-verity-surface border border-verity-border rounded-lg p-4 text-center hover:border-verity-orbit transition-colors">
      <div class="text-2xl font-bold text-verity-nucleus">{charts.length}</div>
      <div class="text-xs text-verity-text-secondary mt-1">Charts</div>
    </div>
    <div class="bg-verity-surface border border-verity-border rounded-lg p-4 text-center hover:border-verity-orbit transition-colors">
      <div class="text-2xl font-bold text-verity-nucleus">{totalOverrides}</div>
      <div class="text-xs text-verity-text-secondary mt-1">Image Overrides</div>
    </div>
    <div class="bg-verity-surface border border-verity-border rounded-lg p-4 text-center hover:border-verity-orbit transition-colors">
      <div class="text-2xl font-bold text-verity-nucleus">{totalCVEs}</div>
      <div class="text-xs text-verity-text-secondary mt-1">Open CVEs</div>
    </div>
    <div class="bg-verity-surface border border-verity-border rounded-lg p-4 text-center hover:border-verity-orbit transition-colors">
      <div class="text-2xl font-bold text-verity-nucleus">OCI</div>
      <div class="text-xs text-verity-text-secondary mt-1">Registry</div>
    </div>
  </div>

  {
    charts.length === 0 && (
      <div class="bg-verity-surface border border-verity-border rounded-lg p-8 text-center">
        <p class="text-verity-text-muted">
          No wrapper charts have been generated yet. Charts are generated daily at 04:00 UTC after
          the patching pipeline completes.
        </p>
      </div>
    )
  }

  <!-- How it works -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4 text-verity-text-primary">How it works</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
      <div class="bg-verity-surface border border-verity-border rounded-lg p-4">
        <div class="text-verity-nucleus font-bold mb-1">1. Wrapper chart</div>
        <p class="text-verity-text-secondary">
          A thin Helm chart that declares the original chart as a dependency and overrides <code
            class="text-xs">values.yaml</code
          > to point image references at patched versions.
        </p>
      </div>
      <div class="bg-verity-surface border border-verity-border rounded-lg p-4">
        <div class="text-verity-nucleus font-bold mb-1">2. OCI registry</div>
        <p class="text-verity-text-secondary">
          Wrapper charts are pushed to
          <code class="text-xs"
            >{
              chartsCatalog.chartRegistry ||
                charts[0]?.registry ||
                "oci://ghcr.io/verity-org/charts"
            }</code
          > and can be installed directly via <code class="text-xs">helm install</code>.
        </p>
      </div>
      <div class="bg-verity-surface border border-verity-border rounded-lg p-4">
        <div class="text-verity-nucleus font-bold mb-1">3. Drop-in replace</div>
        <p class="text-verity-text-secondary">
          Install the wrapper chart instead of the original. Helm resolves the dependency and
          applies all patched image overrides automatically.
        </p>
      </div>
    </div>
  </section>

  <!-- Available Charts -->
  <section>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <h2 class="text-xl font-semibold text-verity-text-primary">Available Charts</h2>
      <input
        type="text"
        placeholder={`Search ${charts.length} charts...`}
        class="w-full sm:w-96 px-3 py-2 border border-verity-border rounded-lg text-sm bg-verity-surface text-verity-text-primary placeholder-verity-text-secondary focus:outline-hidden focus:ring-2 focus:ring-verity-nucleus focus:border-verity-nucleus"
        id="chart-search"
        aria-label="Search charts"
      />
    </div>

    <div class="space-y-10">
      {
        charts.map((chart: ChartEntry) => {
          const installCmd = `helm install ${chart.wrapperName} ${chart.registry}/${chart.wrapperName} --version ${chart.wrapperVersion}`;
          const mappingCount = chart.imageMappings.length + chart.valueOverrides.length;
          const chartVulns = chartVulnMap.get(chart.name) ?? { total: 0, severityCounts: {} };

          const sectionSearchable = [
            chart.name.toLowerCase(),
            chart.version.toLowerCase(),
            chart.wrapperName?.toLowerCase() ?? "",
            chart.repository?.toLowerCase() ?? "",
            installCmd.toLowerCase(),
            ...chart.imageMappings.map((m: ChartImageMapping) =>
              `${m.originalRepo} ${m.originalTag} ${m.patchedRepo} ${m.patchedTag}`.toLowerCase()
            ),
          ]
            .join(" ")
            .trim();

          return (
            <div class="chart-section" data-searchable={sectionSearchable}>
              {/* Section header — matches ImageCatalog category headers */}
              <div class="flex items-center gap-3 mb-4 pb-2 border-b border-verity-border flex-wrap">
                <h3 class="text-sm font-semibold text-verity-text-primary tracking-wider uppercase">
                  {chart.name}
                </h3>
                <span class="text-xs px-2 py-0.5 rounded-full bg-verity-void border border-verity-border text-verity-text-muted font-mono">
                  v{chart.version}
                </span>
                <SeverityBadges summary={chartVulns} />
                <span class="text-xs px-2 py-0.5 rounded-full bg-verity-surface border border-verity-border text-verity-text-muted">
                  {mappingCount} {mappingCount === 1 ? "override" : "overrides"}
                </span>
              </div>

              {/* Install command */}
              <div class="px-3 py-2 mb-3">
                <div class="relative">
                  <pre class="font-mono text-xs bg-verity-void border border-verity-border rounded px-3 py-2 pr-10 overflow-x-auto text-verity-text-primary">{installCmd}</pre>
                  <div class="absolute top-1.5 right-1.5">
                    <CopyButton text={installCmd} />
                  </div>
                </div>
              </div>

              {/* Column headers — desktop only */}
              <div class="hidden sm:grid sm:grid-cols-[1fr_7.5rem_4.5rem_1fr] gap-x-4 px-3 pb-2 text-xs text-verity-text-muted uppercase tracking-wider">
                <span>Original</span>
                <span>Type</span>
                <span>CVEs</span>
                <span>Patched Reference</span>
              </div>

              {/* Image mapping rows */}
              {chart.imageMappings.map((m: ChartImageMapping) => {
                const imgName = patchedRefToName(m.patchedRepo);
                const imgVulns = getImageVulns(m.patchedRepo, m.patchedTag);
                const rowSearchable = `${m.originalRepo} ${m.originalTag} ${m.patchedRepo} ${m.patchedTag}`.toLowerCase();
                return (
                  <a
                    href={`${base}catalog/${imgName}/`}
                    class="chart-row grid grid-cols-1 sm:grid-cols-[1fr_7.5rem_4.5rem_1fr] gap-x-4 gap-y-1 items-center px-3 py-3 border-b border-verity-border/50 transition-colors hover:bg-verity-surface/80"
                    data-searchable={rowSearchable}
                  >
                    <div class="text-sm text-verity-text-primary font-medium truncate">
                      {m.originalRepo}:{m.originalTag}
                    </div>
                    <div class="flex items-center">
                      <SourceBadge source={imageSourceMap.get(imgName) ?? "copa"} />
                    </div>
                    <div class="flex items-center">
                      <SeverityBadges summary={imgVulns} />
                    </div>
                    <div class="text-xs text-verity-text-secondary font-mono truncate">
                      {m.patchedRepo}:{m.patchedTag}
                    </div>
                  </a>
                );
              })}

              {/* Value override rows */}
              {chart.valueOverrides.map((v) => (
                <div
                  class="chart-value-row grid grid-cols-1 sm:grid-cols-[1fr_7.5rem_4.5rem_1fr] gap-x-4 gap-y-1 items-center px-3 py-3 border-b border-verity-border/50"
                  data-searchable={`${v.path} ${v.value}`.toLowerCase()}
                >
                  <div class="text-sm text-verity-text-muted font-mono truncate">{v.path}</div>
                  <div />
                  <div />
                  <div class="text-xs text-verity-nucleus font-mono truncate">{v.value}</div>
                </div>
              ))}
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="mt-12 text-center text-xs text-verity-text-muted">
    Charts generated daily at 04:00 UTC. Powered by <a
      href="https://github.com/verity-org/verity"
      class="underline hover:text-verity-nucleus">Verity</a
    > chart-gen.
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("chart-search") as HTMLInputElement | null;

  function applySearch() {
    const query = input?.value.toLowerCase() ?? "";
    document.querySelectorAll<HTMLElement>(".chart-section").forEach((section) => {
      const rows = section.querySelectorAll<HTMLElement>(".chart-row, .chart-value-row");
      const sectionSearchable = section.getAttribute("data-searchable") ?? "";
      let visible = 0;
      const chartMatches = !query || sectionSearchable.includes(query);
      rows.forEach((row) => {
        const text = row.getAttribute("data-searchable") ?? "";
        const show = chartMatches || text.includes(query);
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      section.style.display = visible > 0 || chartMatches ? "" : "none";
    });
  }

  input?.addEventListener("input", applySearch);
</script>
