---
import type { FullCatalogImage } from "../data/full-catalog.ts";
import { fullCatalog, REGISTRY, totalImages, upstreamPath } from "../data/full-catalog.ts";
import { getIntegerCatalog } from "../data/integer-catalog.ts";
import type { SiteImage, VulnSummary } from "../lib/catalog.ts";
import { getAllImages } from "../lib/catalog.ts";
import { patchedRefToName } from "../lib/refs.ts";
import SeverityBadges from "./SeverityBadges.astro";
import SourceBadge from "./SourceBadge.astro";

const base = import.meta.env.BASE_URL;

const scanDataMap = new Map<string, SiteImage>();
for (const img of getAllImages()) {
  const name = patchedRefToName(img.patchedRef);
  if (name) {
    scanDataMap.set(name, img);
  }
}

// Build lookup maps from integer catalog for FIPS badges and variant counts
const integerFipsSet = new Set<string>();
const integerImageSet = new Set<string>();
const integerVariantCounts = new Map<string, number>();
const integerVariantTypes = new Map<string, string>();
const { images: integerImages } = getIntegerCatalog();
for (const img of integerImages) {
  integerImageSet.add(img.name);
  const latestVersion = img.versions.find((v) => v.latest) ?? img.versions.at(-1);
  if (latestVersion) {
    integerVariantCounts.set(img.name, latestVersion.variants.length);
    const types = latestVersion.variants.map((v) => v.type);
    integerVariantTypes.set(img.name, types.join(" "));
    if (types.includes("fips")) {
      integerFipsSet.add(img.name);
    }
  }
}

// Helper to get vulnerability summary for an image
function getVulnSummary(image: FullCatalogImage): VulnSummary {
  if (image.source !== "copa") {
    return { total: 0, severityCounts: {} };
  }

  const scanData = scanDataMap.get(image.name);
  if (scanData) {
    return scanData.afterVulns;
  }
  // No scan data yet — copa images without scan data are newly added or awaiting first scan.
  return { total: 0, severityCounts: {} };
}
---

<div>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <input
      type="text"
      placeholder={`Search ${totalImages} images...`}
      class="w-full sm:w-96 px-3 py-2 border border-verity-border rounded-lg text-sm bg-verity-surface text-verity-text-primary placeholder-verity-text-secondary focus:outline-hidden focus:ring-2 focus:ring-verity-nucleus focus:border-verity-nucleus"
      id="catalog-search"
      aria-label="Search images"
    />

    <div
      class="flex items-center p-1 bg-verity-surface border border-verity-border rounded-lg text-sm"
      id="catalog-filter"
      role="group"
      aria-label="Filter by image type"
    >
      <button
        class="filter-btn px-3 py-1.5 rounded-md font-medium transition-colors"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      <button
        class="filter-btn px-3 py-1.5 rounded-md font-medium transition-colors"
        data-filter="integer"
        aria-pressed="false"
      >
        Wolfi-Based
      </button>
      <button
        class="filter-btn px-3 py-1.5 rounded-md font-medium transition-colors"
        data-filter="copa"
        aria-pressed="false"
      >
        Patched
      </button>
    </div>
  </div>

  <div id="catalog-grid" class="space-y-10">
    {
      fullCatalog.map((category) => (
        <div class="catalog-category" data-category={category.id}>
          <div class="flex items-center gap-3 mb-4 pb-2 border-b border-verity-border">
            <h3 class="text-sm font-semibold text-verity-text-primary tracking-wider uppercase">
              {category.label}
            </h3>
            <span class="text-xs px-2 py-0.5 rounded-full bg-verity-surface border border-verity-border text-verity-text-muted">
              {category.images.length}
            </span>
          </div>

          <div class="hidden sm:grid sm:grid-cols-[1fr_7.5rem_4.5rem_1fr] gap-x-4 px-3 pb-2 text-xs text-verity-text-muted uppercase tracking-wider">
            <span>Image</span>
            <span>Type</span>
            <span>Vulns</span>
            <span>Pull Reference</span>
          </div>

          <div>
            {category.images.map((image: FullCatalogImage) => {
              const vulnSummary = getVulnSummary(image);
              const pullRef = `${REGISTRY}/${image.source === "integer" ? (image.integerName ?? image.name) : upstreamPath(image)}`;
              return (
                <a
                  href={`${base}catalog/${image.name}/`}
                  class="catalog-row grid grid-cols-1 sm:grid-cols-[1fr_7.5rem_4.5rem_1fr] gap-x-4 gap-y-1 items-center px-3 py-3 border-b border-verity-border/50 transition-colors hover:bg-verity-surface/80"
                  data-source={image.source}
                  data-searchable={
                    image.name.toLowerCase() +
                    " " +
                    (image.label ?? "").toLowerCase() +
                    " " +
                    (image.upstream ?? "").toLowerCase() +
                    " " +
                    (integerVariantTypes.get(image.integerName ?? image.name) ??
                      image.variants?.join(" ") ??
                      "") +
                    " " +
                    category.label.toLowerCase()
                  }
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-sm text-verity-text-primary font-medium truncate">
                      {image.label ?? image.name}
                    </span>
                    <div class="flex items-center gap-1.5 shrink-0">
                      {(integerImageSet.has(image.integerName ?? image.name)
                        ? integerFipsSet.has(image.integerName ?? image.name)
                        : image.variants?.includes("fips")) && (
                        <span class="text-[0.65rem] leading-none px-1.5 py-0.5 rounded bg-amber-950/40 text-amber-400 border border-amber-800/50 uppercase font-semibold">
                          FIPS
                        </span>
                      )}
                      {(() => {
                        const count =
                          integerVariantCounts.get(image.integerName ?? image.name) ??
                          image.variants?.length ??
                          0;
                        return count > 1 ? (
                          <span class="text-[0.65rem] leading-none px-1.5 py-0.5 rounded bg-verity-surface text-verity-text-muted border border-verity-border">
                            {count} variants
                          </span>
                        ) : null;
                      })()}
                    </div>
                  </div>

                  <div class="flex items-center">
                    <SourceBadge source={image.source} />
                  </div>

                  <div class="flex items-center">
                    <SeverityBadges summary={vulnSummary} />
                  </div>

                  <div class="text-xs text-verity-text-secondary font-mono truncate">{pullRef}</div>
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
  <div
    id="catalog-empty"
    class="hidden rounded-lg border border-verity-border bg-verity-surface px-4 py-8 text-center shadow-[0_0_24px_rgba(0,0,0,0.24)]"
    aria-live="polite"
  >
    <div class="mb-3 font-[var(--font-code)] text-xs text-verity-nucleus" aria-hidden="true">
      $ catalog query returned 0 images
    </div>
    <p class="text-sm text-verity-text-muted mb-4">No images match your current search/filter.</p>
    <button
      id="catalog-clear"
      class="rounded border border-verity-border-2 px-3 py-2 text-xs uppercase tracking-[0.12em] text-verity-orbit transition-colors hover:border-verity-nucleus hover:text-verity-nucleus"
    >
      Clear filter
    </button>
  </div>
</div>

<script>
  const input = document.getElementById("catalog-search") as HTMLInputElement;
  const filterContainer = document.getElementById("catalog-filter");
  const filterBtns = filterContainer?.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const emptyState = document.getElementById("catalog-empty") as HTMLElement | null;
  const clearBtn = document.getElementById("catalog-clear") as HTMLButtonElement | null;
  const catalogGrid = document.getElementById("catalog-grid") as HTMLElement | null;

  type FilterValue = "all" | "integer" | "copa";
  const VALID_FILTERS = new Set<FilterValue>(["all", "integer", "copa"]);
  let currentFilter: FilterValue = "all";

  function normalizeFilter(value: string | null): FilterValue {
    return VALID_FILTERS.has(value as FilterValue) ? (value as FilterValue) : "all";
  }

  // Initialize from URL or localStorage
  const urlParams = new URLSearchParams(window.location.search);
  const rawFilter = urlParams.get("filter") || localStorage.getItem("catalog-filter");
  setFilter(normalizeFilter(rawFilter));

  function setFilter(filter: FilterValue) {
    currentFilter = filter;
    localStorage.setItem("catalog-filter", filter);

    // Update URL without reload
    const url = new URL(window.location.href);
    if (filter === "all") {
      url.searchParams.delete("filter");
    } else {
      url.searchParams.set("filter", filter);
    }
    window.history.replaceState({}, "", url);

    // Update button styles
    filterBtns?.forEach((btn) => {
      const btnFilter = btn.getAttribute("data-filter");
      btn.setAttribute("aria-pressed", String(btnFilter === filter));
      if (btnFilter === filter) {
        btn.classList.add("bg-verity-nucleus", "text-[#002820]");
        btn.classList.remove("text-verity-text-secondary", "hover:bg-verity-void");
      } else {
        btn.classList.remove("bg-verity-nucleus", "text-[#002820]");
        btn.classList.add("text-verity-text-secondary", "hover:bg-verity-void");
      }
    });

    applyFilters();
  }

  function applyFilters() {
    const query = input?.value.toLowerCase() ?? "";
    const categories = document.querySelectorAll<HTMLElement>(".catalog-category");
    let totalVisible = 0;

    categories.forEach((cat) => {
      const rows = cat.querySelectorAll<HTMLElement>(".catalog-row");
      let visible = 0;

      rows.forEach((row) => {
        const text = row.getAttribute("data-searchable") ?? "";
        const source = row.getAttribute("data-source") ?? "";
        const matchesSearch = !query || text.includes(query);
        const matchesFilter = currentFilter === "all" || source === currentFilter;
        const show = matchesSearch && matchesFilter;
        row.style.display = show ? "" : "none";
        if (show) {
          visible++;
          totalVisible++;
        }
      });

      cat.style.display = visible > 0 ? "" : "none";
    });

    const hasResults = totalVisible > 0;
    if (emptyState) emptyState.classList.toggle("hidden", hasResults);
    if (catalogGrid) catalogGrid.classList.toggle("hidden", !hasResults);
  }

  // Event listeners
  filterBtns?.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = normalizeFilter(btn.getAttribute("data-filter"));
      setFilter(filter);
    });
  });

  if (input) {
    input.addEventListener("input", applyFilters);
  }
  clearBtn?.addEventListener("click", () => {
    if (input) input.value = "";
    setFilter("all");
  });
</script>
